{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yoo-SeungHyeon/shyai/Amigurumi/spec/pattern.schema.json",
  "title": "Amigurumi Pattern",
  "description": "Amigurumi 모델의 구조화 도안 출력 형식 (v0.1)",
  "type": "object",
  "required": ["schema_version", "meta", "materials", "parts", "assembly"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "meta": {
      "type": "object",
      "required": ["title", "difficulty", "finished_height_cm", "terminology"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source_image": { "type": "string" },
        "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
        "finished_height_cm": { "type": "number", "exclusiveMinimum": 0 },
        "terminology": { "enum": ["US", "UK"], "default": "US" }
      }
    },
    "materials": {
      "type": "object",
      "required": ["hook_mm", "yarns"],
      "additionalProperties": false,
      "properties": {
        "hook_mm": { "type": "number", "exclusiveMinimum": 0 },
        "yarns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "hex"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^Y[0-9]+$" },
              "name": { "type": "string" },
              "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "weight": { "type": "integer", "minimum": 0, "maximum": 7, "description": "CYC Standard Yarn Weight (0 lace ~ 7 jumbo)" },
              "estimated_m": { "type": "number", "minimum": 0 }
            }
          }
        },
        "notions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["safety_eyes", "safety_nose", "fiberfill", "stitch_marker", "tapestry_needle", "pellets", "wire", "other"] },
              "size_mm": { "type": "number", "exclusiveMinimum": 0 },
              "quantity": { "type": "integer", "minimum": 1 },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "gauge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stitches_per_10cm": { "type": "number", "exclusiveMinimum": 0 },
        "rounds_per_10cm": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    },
    "assembly": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "part", "target", "position", "method"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "part": { "type": "string" },
          "target": { "type": "string" },
          "position": { "$ref": "#/$defs/position" },
          "method": { "enum": ["whipstitch", "mattress", "glue"] },
          "instruction": { "type": "string" }
        }
      }
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target", "feature"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["embroidery", "felt", "other"] },
          "target": { "type": "string" },
          "feature": { "type": "string" },
          "yarn": { "type": "string" },
          "position": { "$ref": "#/$defs/position" },
          "instruction": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": ["id", "name", "quantity", "yarn", "construction", "start", "rounds", "stuffing", "finish"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "yarn": { "type": "string" },
        "construction": { "enum": ["spiral", "joined", "flat"] },
        "start": {
          "type": "object",
          "required": ["type", "count"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["magic_ring", "chain"] },
            "count": { "type": "integer", "minimum": 1 }
          }
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/round" }
        },
        "stuffing": { "enum": ["firm", "light", "none"] },
        "finish": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["close", "leave_tail", "fasten_off"] },
            "tail_cm": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "round": {
      "type": "object",
      "required": ["from", "to", "stitches", "count"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "integer", "minimum": 1 },
        "to": { "type": "integer", "minimum": 1 },
        "stitches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stitch" } },
        "count": { "type": "integer", "minimum": 1 },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["insert_safety_eyes", "stuff", "place_marker"] },
              "between_rounds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
              "spacing_stitches": { "type": "integer", "minimum": 1 },
              "label": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "stitch": {
      "type": "object",
      "required": ["op"],
      "oneOf": [
        {
          "properties": {
            "op": { "enum": ["sc", "hdc", "dc", "sl_st", "inc", "dec"] },
            "n": { "type": "integer", "minimum": 1, "default": 1 },
            "loop": { "enum": ["both", "FLO", "BLO"], "default": "both" }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "op": { "enum": ["ch", "skip"] },
            "n": { "type": "integer", "minimum": 1, "default": 1 }
          },
          "additionalProperties": false
        },
        {
          "required": ["times", "body"],
          "properties": {
            "op": { "const": "repeat" },
            "times": { "type": "integer", "minimum": 1 },
            "body": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stitch" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["yarn"],
          "properties": {
            "op": { "const": "color" },
            "yarn": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "position": {
      "type": "object",
      "required": ["rounds", "anchor"],
      "additionalProperties": false,
      "properties": {
        "rounds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
        "anchor": { "enum": ["front_center", "side_left", "side_right", "back_center", "top", "bottom"] },
        "offset_stitches": { "type": "integer", "default": 0 }
      }
    }
  }
}
